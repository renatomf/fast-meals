# Banco de Dados
DATABASE_URL=postgresql://fastmeals:fastmeals123@localhost:5432/fastmeals

# JWT
JWT_SECRET=sua-chave-secreta-aqui-trocar-em-producao
JWT_REFRESH_SECRET=sua-chave-refresh-aqui-trocar-em-producao
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Servidor
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
# Origem do front autorizada no CORS
CORS_ORIGIN=http://localhost:3000

# Frontend
# O front chama a API pelo caminho relativo /api (proxy do Vite em dev, nginx no Docker),
# para que o cookie httpOnly do refresh token fique na mesma origem.
VITE_API_URL=/api
