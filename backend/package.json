{
  "name": "@fastmeals/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.ts",
    "start": "node src/server.ts",
    "seed": "node --env-file-if-exists=../.env src/db/seed.ts",
    "seed:load": "node --env-file-if-exists=../.env src/db/seed-load.ts",
    "demo:refresh": "node --env-file-if-exists=../.env src/db/demo-refresh.ts",
    "bench:assignment": "node bench/assignment.ts",
    "bench:listings": "node --env-file-if-exists=../.env bench/listings.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "simulate": "node scripts/simulate.ts",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "@fastify/websocket": "11.3.7",
    "@fastmeals/contracts": "1.0.0",
    "bcrypt": "6.0.0",
    "drizzle-orm": "0.45.4",
    "fast-jwt": "6.3.6",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/bcrypt": "6.0.0",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "pino-pretty": "13.2.0",
    "vitest": "5.1.0",
    "ws": "8.22.1"
  }
}
