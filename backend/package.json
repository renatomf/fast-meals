{
  "name": "@fastmeals/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.ts",
    "start": "node src/server.ts",
    "seed": "node --env-file-if-exists=../.env src/db/seed.ts",
    "seed:load": "node --env-file-if-exists=../.env src/db/seed-load.ts",
    "bench:assignment": "node bench/assignment.ts",
    "bench:listings": "node --env-file-if-exists=../.env bench/listings.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/websocket": "11.3.4",
    "@fastmeals/contracts": "1.0.0",
    "bcrypt": "6.0.0",
    "drizzle-orm": "0.45.4",
    "fast-jwt": "6.3.5",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "pino-pretty": "13.2.0",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  }
}
